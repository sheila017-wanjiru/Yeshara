# ── Yeshara — environment ────────────────────────────────────────────
# Copy to .env.local for development, and set the same keys in the
# hosting provider's environment for production.

# Canonical origin. Used for canonical URLs, the sitemap, OG image URLs
# and newsletter confirmation links. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.yeshara.com

# ── Forms ────────────────────────────────────────────────────────────
# Postgres (Supabase or Neon). Run scripts/schema.sql against it once
# before launch. Without this, contact submissions are not persisted.
DATABASE_URL=

# Resend, for transactional email. RESEND_FROM must be an address on a
# domain verified in the Resend dashboard.
# Both keys are required for newsletter double opt-in to work at all.
RESEND_API_KEY=
RESEND_FROM="Yeshara <no-reply@yeshara.com>"

# ── Analytics ────────────────────────────────────────────────────────
# Cookieless by choice — this is what lets the site launch without a
# consent banner. Leave unset to disable analytics entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
