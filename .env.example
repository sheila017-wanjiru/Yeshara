# ── Canonical origin ──────────────────────────────────────────────
# Only needed if the deployment answers on a different host.
# NEXT_PUBLIC_SITE_URL=https://www.yeshara.com

# ── Forms ─────────────────────────────────────────────────────────
# Postgres (Supabase or Neon). Run scripts/schema.sql once first.
DATABASE_URL=

# Resend, for transactional email. Both values are required before
# the newsletter double opt-in will operate.
RESEND_API_KEY=
RESEND_FROM="Yeshara <noreply@yeshara.com>"

# ── Analytics ─────────────────────────────────────────────────────
# Cookieless. Leave unset to disable the script entirely.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=www.yeshara.com
